# Progressive Foods Supermarket - Environment Configuration Guide
# Defense #1: Secret & Build Sanitization

# ==============================================================================
# SAFE PUBLIC CLIENT VARIABLES (Exposed in client bundles via import.meta.env)
# Must only contain non-sensitive configuration, public API endpoints, or public keys.
# ==============================================================================
VITE_PUBLIC_API_URL=https://api.progressivefoods.com.jm/v1
VITE_PUBLIC_STORE_NAME=Progressive Foods Jamaica
VITE_GEMINI_API_KEY=your_public_client_key_here

# Firebase Public Client Configuration (Safe for client bundles)
VITE_FIREBASE_API_KEY=AIzaSyA_samplePublicWebApiKey12345678
VITE_FIREBASE_AUTH_DOMAIN=progressive-foods-retail.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=progressive-foods-retail
VITE_FIREBASE_STORAGE_BUCKET=progressive-foods-retail.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_APP_CHECK_KEY=6Ld_sampleAppCheckSiteKey1234567

# ==============================================================================
# STRICTLY FORBIDDEN FROM CLIENT BUNDLES (Backend / Administrative Only)
# Any variable with ADMIN_, SECRET, PASSWORD, DATABASE_URL, or internal URLs
# is audited and blocked by the build pipeline from reaching the client.
# ==============================================================================
# ADMIN_MASTER_SECRET=do_not_prefix_with_vite
# DATABASE_URL=postgres://user:pass@db.internal:5432/retail
# BACKEND_SIGNING_KEY=secret_key_used_for_totp_and_pricing
