rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // 1. PRODUCTS COLLECTION: Strict Read-Only Catalog
    // Guaranteed: Clients cannot create, modify, or delete product documents,
    // tampering with prices, discounts, or inventory counts is strictly blocked.
    // -------------------------------------------------------------------------
    match /products/{productId} {
      // Allow public or authenticated read of in-store catalog
      allow read: if true;

      // Strictly enforce NO client-side writes under any circumstances
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // 2. STORES & METADATA: Read-Only Reference Data
    // -------------------------------------------------------------------------
    match /stores/{storeId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // 3. DEFAULT DENY: Strict fallback security for all unmapped collections
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
